{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agnovexa OpsDesk",
  "version": "0.3.0",
  "identifier": "com.kllin.agnovexa.opsdesk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "Agnovexa OpsDesk",
        "width": 1460,
        "height": 920,
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ]
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:opsdesk.db"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "人工主导的现场部署运维桌面工作台",
    "longDescription": "Agnovexa OpsDesk 生成部署方案、命令、SQL、验证和回滚草案；所有目标环境操作均由工程师人工执行并回传证据。",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
